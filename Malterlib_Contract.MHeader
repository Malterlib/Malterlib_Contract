Import "../Core/Lib_Malterlib.MTarget"

Repository
{
	!!MalterlibRepoName "Malterlib_Contract.git"

	License #<HeaderOverrides> =+ {
		Path: ["Source/Malterlib_Contract.*"]
		, Header: ["Copyright © Unbroken AB", "SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception", "Copyright (c) 2006-2009 Jonas Persson", "SPDX-License-Identifier: BSL-1.0"]
	}
}

%Group "{Malterlib}/{Lib_Malterlib_Contract}"
{
	%Group "Contract"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Contract/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}

Property
{
	MalterlibLibrary_Contract: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Contract"
	{
		!!MalterlibLibrary_Contract true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Contract: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Contract true
	}
}

Property
{
	!!MalterlibEnableInternalTests true

	MalterlibTests =+ "Malterlib_Contract"
	MalterlibTestFiles_Malterlib_Contract: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}
