Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Contract}"
{
	%Group "Contract"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Contract/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}

Property
{
	MalterlibLibrary_Contract define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Contract"
	{
		!!MalterlibLibrary_Contract true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Contract define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Contract true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Contract"
	MalterlibTestFiles_Malterlib_Contract define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}
